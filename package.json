{
  "name": "church-website",
  "version": "1.0.0",
  "description": "Static church website with automated gallery manifest generation.",
  "scripts": {
    "start": "node server.js",
    "generate-gallery": "node scripts/generate-gallery.js",
    "build-images": "node scripts/generate-gallery.js --build",
    "prepare-gallery": "npm run build-images && npm run generate-gallery",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "prepare-seo": "node scripts/apply-seo.js && node scripts/generate-sitemap.js",
    "generate-pdfs": "node scripts/generate-pdfs.js"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "sharp": "^0.32.0",
    "puppeteer": "^20.0.0"
  }
}
